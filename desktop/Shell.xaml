<ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="THEME" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,20,0,8"/><ComboBox x:Name="AppearanceChoice"/><TextBlock x:Name="AppearanceHint" Style="{StaticResource Muted}" Margin="0,10,0,0"/><Button x:Name="ReplayGuide" Content="Replay getting-started walkthrough" HorizontalAlignment="Left" Margin="0,18,0,0"/><CheckBox x:Name="Animations" Content="Rich animations · on by default" IsChecked="True" Margin="0,20,0,5"/><TextBlock Style="{StaticResource Muted}" Text="Expressive page reveals, orbiting connection cues, hover effects and an animated launch. Switch off for a still, instant interface."/><CheckBox x:Name="LivePreview" Content="Show live phone input in the layout canvas" IsChecked="True" Margin="0,17,0,4"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Application &amp; data" FontSize="15" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" Text="Your custom slots and drafts are saved in your Windows profile. Updating the application keeps them available." Margin="0,14,0,0"/><TextBlock x:Name="DataLocation" Foreground="#B2BAD0" FontSize="11" TextWrapping="Wrap" Margin="0,15,0,12"/><WrapPanel><Button x:Name="OpenData" Content="Open layouts folder" Margin="0,0,10,10"/><Button x:Name="OpenLogs" Content="Open logs" Margin="0,0,10,10"/><Button x:Name="OpenAndroid" Content="Show Android APK" Margin="0,0,10,10"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="PocketPad Desktop 2.1" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Made by Sanjay" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0"/><TextBlock Style="{StaticResource Muted}" Text="Native Windows interface. Local controller bridge. No browser is opened for desktop use." Margin="0,12,0,0"/><TextBlock Style="{StaticResource Muted}" Text="Xbox output uses XInput. PlayStation output uses DS4 and supports two touch contacts plus click. Adaptive triggers and game rumble are not emulated." Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
