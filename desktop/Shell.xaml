     <ScrollViewer x:Name="MobilePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,22,0"><StackPanel><Image x:Name="MobileLogo" Width="118" Height="118" HorizontalAlignment="Left" Margin="-15,-20,0,-7"/><TextBlock Text="PocketPad for Android" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="The same controller. Made for your phone." Style="{StaticResource Muted}" Margin="0,10,0,15"/><Border Background="{DynamicResource SelectedBg}" CornerRadius="7" Padding="11" HorizontalAlignment="Left"><TextBlock x:Name="MobileVersion" Text="ANDROID 1.2  ·  APK" Foreground="{DynamicResource AccentBrush}" FontSize="10"/></Border><Border Background="White" CornerRadius="12" Padding="10" Width="230" Height="230" HorizontalAlignment="Center" Margin="0,23,0,17"><Image x:Name="MobileQr" Stretch="Uniform"/></Border><TextBlock Text="SCAN WITH YOUR PHONE CAMERA" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontSize="9" Margin="0,0,0,18"/><ComboBox x:Name="MobileNetwork"/><TextBox x:Name="MobileDownloadUrl" IsReadOnly="True" FontSize="10" Margin="0,12,0,0"/><Button x:Name="CopyMobileLink" Content="Copy download link" Margin="0,12,0,0"/></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Install the companion" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="01   Scan &amp; download" FontSize="14" Margin="0,25,0,8"/><TextBlock Text="Scan the download QR with your phone camera. It opens this PC’s local APK download page." Style="{StaticResource Muted}"/><TextBlock Text="02   Install PocketPad" FontSize="14" Margin="0,23,0,8"/><TextBlock Text="Open the APK on Android. If asked, allow your browser to install this personal app." Style="{StaticResource Muted}"/><TextBlock Text="03   Pair &amp; play" FontSize="14" Margin=