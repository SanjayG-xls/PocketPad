  <Border Grid.Row="2" Background="{DynamicResource FooterBg}" BorderBrush="#252D3E" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock x:Name="FooterStatus" Text="Starting controller engine…" Foreground="#6F7E9E" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="NATIVE DESKTOP  /  2.1" Foreground="#596780" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
  <Border x:Name="Toast" Grid.RowSpan="3" Background="{DynamicResource ToastBg}" BorderBrush="#626B9C" BorderThickness="1" CornerRadius="9" Padding="20,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,52" Visibility="Collapsed"><TextBlock x:Name="ToastText" Foreground="#E6E8FF"/></Border>

  <Border x:Name="WalkthroughCard" Grid.RowSpan="3" Visibility="Collapsed" Width="395" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,50" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="23"><Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="9" Opacity="0.55"/></Border.Effect><StackPanel><DockPanel><TextBlock x:Name="GuideStep" Text="GETTING STARTED · 1 / 4" Foreground="{DynamicResource AccentBrush}" FontSize="9"/><Button x:Name="GuideSkip" Content="Skip guide" Padding="3,0" FontSize="10" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/></DockPanel><TextBlock x:Name="GuideTitle" FontSize="23" FontWeight="SemiBold" Margin="0,17,0,10"/><TextBlock x:Name="GuideText" Style="{StaticResource Muted}"/><Border Background="{DynamicResource FieldBg}" CornerRadius="9" Padding="12" Margin="0,15,0,7"><StackPanel x:Name="GuidePractice"/></Border><TextBlock x:Name="GuideFeedback" Foreground="{DynamicResource AccentBrush}" FontSize="10" Height="25"/><DockPanel><Button x:Name="GuideBack" Content="Back" DockPanel.Dock="Left"/><Button x:Name="GuideNext" Content="Next" DockPanel.Dock="Right" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
